{
  "name": "reader",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "projectType": "application",
  "prefix": "lb",
  "sourceRoot": "apps/reader/src",
  "tags": ["type:app", "scope:reader"],
  "i18n": {
    "sourceLocale": "es-MX"
  },
  "targets": {
    "build": {
      "executor": "@angular/build:application",
      "outputs": ["{options.outputPath}"],
      "defaultConfiguration": "production",
      "options": {
        "outputPath": "dist/apps/reader",
        "browser": "apps/reader/src/main.ts",
        "tsConfig": "apps/reader/tsconfig.app.json",
        "assets": [
          {
            "glob": "**/*",
            "input": "apps/reader/public"
          }
        ],
        "styles": ["apps/reader/src/styles.css"],
        "polyfills": ["@angular/localize/init"],
        "serviceWorker": "apps/reader/ngsw-config.json"
      },
      "configurations": {
        "production": {
          "budgets": [
            {
              "type": "initial",
              "maximumWarning": "500kb",
              "maximumError": "1mb"
            },
            {
              "type": "anyComponentStyle",
              "maximumWarning": "4kb",
              "maximumError": "8kb"
            }
          ],
          "outputHashing": "all",
          "baseHref": "/lectura-biblica/"
        },
        "development": {
          "optimization": false,
          "extractLicenses": false,
          "sourceMap": true,
          "serviceWorker": false
        }
      }
    },
    "typecheck": {
      "options": {
        "commands": [
          "tsc --noEmit -p apps/reader/tsconfig.app.json",
          "tsc --noEmit -p apps/reader/tsconfig.spec.json"
        ]
      }
    },
    "serve": {
      "continuous": true,
      "readyWhen": {
        "signal": true
      },
      "executor": "@angular/build:dev-server",
      "defaultConfiguration": "development",
      "options": {
        "port": 4210
      },
      "configurations": {
        "production": {
          "buildTarget": "reader:build:production"
        },
        "development": {
          "buildTarget": "reader:build:development"
        }
      }
    },
    "test": {
      "executor": "@angular/build:unit-test",
      "outputs": ["{workspaceRoot}/coverage/reader"],
      "options": {
        "watch": false,
        "coverage": true,
        "coverageInclude": ["apps/reader/src/**/*.ts"],
        "coverageExclude": [
          "apps/reader/src/**/*.spec.ts",
          "apps/reader/src/testing/**",
          "apps/reader/src/main.ts"
        ],
        "coverageReporters": ["text-summary", "json", "html"],
        "coverageThresholds": {
          "statements": 90,
          "lines": 90,
          "functions": 90,
          "branches": 70
        }
      }
    },
    "extract-i18n": {
      "executor": "@angular/build:extract-i18n",
      "options": {
        "buildTarget": "reader:build",
        "format": "xlf2",
        "outputPath": "dist/i18n/reader"
      }
    },
    "pages": {
      "executor": "nx:run-commands",
      "dependsOn": ["build"],
      "outputs": ["{workspaceRoot}/dist/apps/reader/browser/404.html"],
      "cache": true,
      "inputs": ["production", "^production"],
      "options": {
        "command": "node tools/pages/src/prepare.mjs dist/apps/reader/browser"
      }
    },
    "serve-pages": {
      "executor": "nx:run-commands",
      "continuous": true,
      "dependsOn": ["pages"],
      "options": {
        "command": "node tools/pages/src/serve.mjs 4210"
      }
    }
  }
}
